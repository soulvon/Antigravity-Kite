{
  "name": "antigravity-kite",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.1.28",
  "publisher": "soulvon",
  "repository": {
    "type": "git",
    "url": "https://github.com/soulvon/Antigravity-Kite"
  },
  "bugs": {
    "url": "https://github.com/soulvon/Antigravity-Kite/issues"
  },
  "homepage": "https://github.com/soulvon/Antigravity-Kite#readme",
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravityKite",
          "title": "Antigravity Kite",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "antigravityKite": [
        {
          "type": "webview",
          "id": "antigravityKite.sidebar",
          "name": "Antigravity Kite"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityKite.checkForUpdates",
        "title": "%cmd.checkUpdates%",
        "category": "Antigravity Kite"
      },
      {
        "command": "antigravityKite.openLogPanel",
        "title": "%cmd.openLogPanel%",
        "category": "Antigravity Kite"
      },
      {
        "command": "antigravityKite.quickSwitchAccount",
        "title": "%cmd.quickSwitch%",
        "category": "Antigravity Kite"
      },
      {
        "command": "antigravityKite.openSidebar",
        "title": "%cmd.openSidebar%",
        "category": "Antigravity Kite"
      },
      {
        "command": "antigravityKite.refreshQuota",
        "title": "%cmd.refreshQuota%",
        "category": "Antigravity Kite"
      },
      {
        "command": "antigravityKite.healthRecheck",
        "title": "%cmd.healthRecheck%",
        "category": "Antigravity Kite"
      },
      {
        "command": "antigravityKite.openSettings",
        "title": "%cmd.openSettings%",
        "category": "Antigravity Kite"
      }
    ],
    "keybindings": [
      {
        "command": "antigravityKite.openLogPanel",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "antigravityKite.update.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCheck%"
        },
        "antigravityKite.update.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoInstall%"
        },
        "antigravityKite.autoConfirmDeclaration": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoConfirmDeclaration%"
        },
        "antigravityKite.cdpPort": {
          "type": "number",
          "default": 9333,
          "description": "%config.cdpPort%"
        },
        "antigravityKite.cdpHeartbeatMs": {
          "type": "number",
          "default": 500,
          "minimum": 200,
          "maximum": 5000,
          "description": "%config.cdpHeartbeatMs%"
        },
        "antigravityKite.quotaRefreshMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 120,
          "description": "%config.quotaRefreshMinutes%"
        },
        "antigravityKite.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.enabled%"
        },
        "antigravityKite.statusBar.showAccount": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showAccount%"
        },
        "antigravityKite.statusBar.showModels": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showModels%"
        },
        "antigravityKite.statusBar.showCredits": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showCredits%"
        },
        "antigravityKite.statusBar.showPool": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showPool%"
        },
        "antigravityKite.statusBar.position": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "%config.statusBar.position.left%",
            "%config.statusBar.position.right%"
          ],
          "default": "right",
          "description": "%config.statusBar.position%"
        },
        "antigravityKite.statusBar.style": {
          "type": "string",
          "enum": [
            "smart",
            "dot",
            "percent",
            "compact",
            "dual",
            "labeled",
            "full"
          ],
          "enumDescriptions": [
            "%config.statusBar.style.smart%",
            "%config.statusBar.style.dot%",
            "%config.statusBar.style.percent%",
            "%config.statusBar.style.compact%",
            "%config.statusBar.style.dual%",
            "%config.statusBar.style.labeled%",
            "%config.statusBar.style.full%"
          ],
          "default": "full",
          "description": "%config.statusBar.style%"
        },
        "antigravityKite.statusBar.showResetCountdown": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showResetCountdown%"
        },
        "antigravityKite.statusBar.showTier": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showTier%"
        },
        "antigravityKite.statusBar.families": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "gemini",
              "argon"
            ]
          },
          "default": [
            "claude",
            "gemini",
            "argon"
          ],
          "description": "%config.statusBar.families%"
        },
        "antigravityKite.statusBar.refreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 600,
          "description": "%config.statusBar.refreshSeconds%"
        },
        "antigravityKite.switch.syncGeminiFiles": {
          "type": "boolean",
          "default": true,
          "description": "%config.syncGeminiFiles%"
        },
        "antigravityKite.locale": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "enumDescriptions": [
            "%config.locale.auto%",
            "%config.locale.zh%",
            "%config.locale.en%"
          ],
          "default": "auto",
          "description": "%config.locale%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/check-i18n.js && node scripts/check_webview_hardening.mjs && node scripts/check_platform_gates.mjs && node scripts/check_decl_suppressor.mjs",
    "watch": "tsc -watch -p ./",
    "package": "node ./scripts/update-version.js && npm run compile && vsce package --skip-license",
    "check:release": "node scripts/check_release_readiness.mjs"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "adm-zip": "^0.6.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "antigravity",
    "multi-account",
    "account-switcher",
    "account-pool",
    "seamless-switch",
    "quota-monitor",
    "gemini",
    "claude",
    "auto-switch",
    "ide-extension"
  ]
}
