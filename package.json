{
  "name": "antigravity-kite",
  "displayName": "Antigravity Kite",
  "description": "为 Antigravity IDE 量身打造的无感多账号切换与号池管理插件",
  "version": "0.8.39",
  "publisher": "soulvon",
  "repository": {
    "type": "git",
    "url": "https://github.com/soulvon/Antigravity-Kite"
  },
  "bugs": {
    "url": "https://github.com/soulvon/Antigravity-Kite/issues"
  },
  "homepage": "https://github.com/soulvon/Antigravity-Kite#readme",
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravityKite",
          "title": "Antigravity Kite",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "antigravityKite": [
        {
          "type": "webview",
          "id": "antigravityKite.sidebar",
          "name": "Antigravity Kite"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityKite.checkForUpdates",
        "title": "Kite: 检查更新",
        "category": "Antigravity Kite"
      },
      {
        "command": "antigravityKite.openLogPanel",
        "title": "Kite: 打开统计面板",
        "category": "Antigravity Kite"
      }
    ],
    "keybindings": [
      {
        "command": "antigravityKite.openLogPanel",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Antigravity Kite",
      "properties": {
        "antigravityKite.update.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动检查更新"
        },
        "antigravityKite.update.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "发现新版本时自动静默安装"
        },
        "antigravityKite.customIdeExePath": {
          "type": "string",
          "default": "",
          "description": "自定义 Antigravity 主程序可执行文件路径 (用于多版本启动分身)"
        },
        "antigravityKite.autoConfirmDeclaration": {
          "type": "boolean",
          "default": true,
          "description": "切换账号时自动确认安全声明（Security Notice & Data Use），切号不再弹窗。前提：IDE 以调试端口启动——首次切号时会引导开启一次（自动修改快捷方式并重启 IDE，仅此一次）。未开启调试端口时，每次切换会弹一次声明，需手动点击。"
        },
        "antigravityKite.cdpPort": {
          "type": "number",
          "default": 9333,
          "description": "调试端口号（--remote-debugging-port）。9222 会作为兜底自动尝试。通常无需修改。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node ./scripts/update-version.js && npm run compile && vsce package --skip-license"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "sql.js": "^1.14.1"
  }
}
